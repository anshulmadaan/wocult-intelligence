rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isWocultStaff() {
      return request.auth != null
        && request.auth.token.email in [
          "poorvi.arya23@gmail.com",
          "divya.madaan@gmail.com",
          "anmadaan@gmail.com"
        ];
    }

    function isVerifiedAuth() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function podcastSessionPath(sessionId) {
      return /databases/(default)/documents/podcast_sessions/$(sessionId);
    }

    function canAccessPodcastRecording(sessionId, uid) {
      return isWocultStaff()
        || (
          isVerifiedAuth()
          && request.auth.uid == uid
          && firestore.exists(podcastSessionPath(sessionId))
          && firestore.get(podcastSessionPath(sessionId)).data.normalizedGuestEmail == request.auth.token.email.lower()
          && (
            !("guestUid" in firestore.get(podcastSessionPath(sessionId)).data)
            || firestore.get(podcastSessionPath(sessionId)).data.guestUid == ""
            || firestore.get(podcastSessionPath(sessionId)).data.guestUid == request.auth.uid
          )
        );
    }

    function isValidPodcastRecordingContentType(versionFile) {
      return request.resource.contentType.matches('audio/.*')
        || (
          versionFile.matches('.*\\.webm')
          && request.resource.contentType.matches('video/webm(;[ ]*codecs=.*)?')
        );
    }

    match /podcast_recordings/{sessionId}/{uid}/{questionId}/{versionFile} {
      allow read: if canAccessPodcastRecording(sessionId, uid);
      allow write: if canAccessPodcastRecording(sessionId, uid)
        && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024
        && isValidPodcastRecordingContentType(versionFile);
    }

    match /interview_recordings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /editorial_calendar_images/{allPaths=**} {
      allow read: if true;
      allow write: if isWocultStaff();
    }
  }
}
