rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isWocultStaff() {
      return request.auth != null
        && request.auth.token.email in [
          "poorvi.arya23@gmail.com",
          "divya.madaan@gmail.com",
          "anmadaan@gmail.com"
        ];
    }

    function isCanvaAdmin() {
      return request.auth != null
        && request.auth.token.email == "anmadaan@gmail.com";
    }

    function isVerifiedAuth() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function authedEmailLower() {
      return request.auth.token.email.lower();
    }

    function podcastSessionPath(sessionId) {
      return /databases/$(database)/documents/podcast_sessions/$(sessionId);
    }

    function isPodcastGuestSession(session) {
      return isVerifiedAuth()
        && session.data.normalizedGuestEmail == authedEmailLower()
        && (
          !("guestUid" in session.data)
          || session.data.guestUid == ""
          || session.data.guestUid == request.auth.uid
        );
    }

    function canAccessPodcastSession(sessionId) {
      return isWocultStaff()
        || (
          exists(podcastSessionPath(sessionId))
          && isPodcastGuestSession(get(podcastSessionPath(sessionId)))
        );
    }

    function guestPodcastSessionUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "guestUid",
          "status",
          "openedAt",
          "completedQuestionCount",
          "submittedAt",
          "updatedAt"
        ])
        && request.resource.data.normalizedGuestEmail == resource.data.normalizedGuestEmail
        && request.resource.data.guestEmail == resource.data.guestEmail
        && request.resource.data.questions == resource.data.questions
        && request.resource.data.questionCount == resource.data.questionCount
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.guestUid == request.auth.uid
        && (
          (
            resource.data.status == "feedback_shared"
            && request.resource.data.status == "feedback_shared"
          )
          ||
          (
            resource.data.status != "feedback_shared"
            && request.resource.data.status in ["opened", "in_progress", "submitted"]
          )
        );
    }

    function isValidGuestPodcastResponseCreate(questionId) {
      return request.resource.data.keys().hasOnly([
          "questionId",
          "questionOrder",
          "questionText",
          "hasSavedResponse",
          "latestVersionId",
          "latestVersionNumber",
          "responseUpdatedAt"
        ])
        && request.resource.data.questionId == questionId
        && request.resource.data.hasSavedResponse == true
        && request.resource.data.latestVersionId is string
        && request.resource.data.latestVersionNumber is int;
    }

    function isValidGuestPodcastResponseUpdate(questionId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "questionId",
          "questionOrder",
          "questionText",
          "hasSavedResponse",
          "latestVersionId",
          "latestVersionNumber",
          "responseUpdatedAt"
        ])
        && request.resource.data.questionId == questionId
        && request.resource.data.questionOrder == resource.data.questionOrder
        && request.resource.data.questionText == resource.data.questionText
        && request.resource.data.hasSavedResponse == true
        && request.resource.data.latestVersionId is string
        && request.resource.data.latestVersionNumber is int;
    }

    function isValidGuestPodcastVersionCreate(sessionId, questionId) {
      return request.resource.data.keys().hasOnly([
          "versionNumber",
          "storagePath",
          "audioMimeType",
          "duration",
          "transcript",
          "transcriptionStatus",
          "transcriptionError",
          "transcriptionSource",
          "createdAt",
          "createdByUid"
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.versionNumber is int
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^podcast_recordings/' + sessionId + '/' + request.auth.uid + '/' + questionId + '/.+')
        && request.resource.data.transcriptionStatus == "not_requested"
        && request.resource.data.transcript == ""
        && request.resource.data.transcriptionError == ""
        && (
          !("transcriptionSource" in request.resource.data)
          || request.resource.data.transcriptionSource == ""
        );
    }

    function isSafeCanvaUrl(value) {
      return value is string
        && value.matches('^https?://.+');
    }

    function isSafePreviewImageUrl(value) {
      return value is string
        && (
          value == ""
          ||
          value.matches('^https?://.+')
          || value in [
            "assets/canva-template-1.png",
            "assets/canva-template-2.png",
            "assets/canva-template-3.png"
          ]
        );
    }

    function isValidCanvaFieldShape(field) {
      return field.keys().hasOnly(["id", "type", "label"])
        && field.id is string
        && field.type in ["headline", "subtitle", "bullet"]
        && field.label is string;
    }

    function isValidCanvaFields(fields) {
      return fields is list
        && isValidCanvaFieldList(fields);
    }

    function isValidCanvaFields1(fields) {
      return isValidCanvaFieldShape(fields[0])
        && fields[0].type == "headline";
    }

    function isValidCanvaFields2(fields) {
      return isValidCanvaFieldShape(fields[0])
        && isValidCanvaFieldShape(fields[1])
        && fields[0].type == "headline"
        && fields[1].type != "headline";
    }

    function isValidCanvaFields3(fields) {
      return isValidCanvaFieldShape(fields[0])
        && isValidCanvaFieldShape(fields[1])
        && isValidCanvaFieldShape(fields[2])
        && fields[0].type == "headline"
        && fields[1].type != "headline"
        && fields[2].type == "bullet";
    }

    function isValidCanvaFields4(fields) {
      return isValidCanvaFieldShape(fields[0])
        && isValidCanvaFieldShape(fields[1])
        && isValidCanvaFieldShape(fields[2])
        && isValidCanvaFieldShape(fields[3])
        && fields[0].type == "headline"
        && fields[1].type != "headline"
        && fields[2].type == "bullet"
        && fields[3].type == "bullet";
    }

    function isValidCanvaFields5(fields) {
      return isValidCanvaFieldShape(fields[0])
        && isValidCanvaFieldShape(fields[1])
        && isValidCanvaFieldShape(fields[2])
        && isValidCanvaFieldShape(fields[3])
        && isValidCanvaFieldShape(fields[4])
        && fields[0].type == "headline"
        && fields[1].type != "headline"
        && fields[2].type == "bullet"
        && fields[3].type == "bullet"
        && fields[4].type == "bullet";
    }

    function isValidCanvaFields6(fields) {
      return isValidCanvaFieldShape(fields[0])
        && isValidCanvaFieldShape(fields[1])
        && isValidCanvaFieldShape(fields[2])
        && isValidCanvaFieldShape(fields[3])
        && isValidCanvaFieldShape(fields[4])
        && isValidCanvaFieldShape(fields[5])
        && fields[0].type == "headline"
        && fields[1].type != "headline"
        && fields[2].type == "bullet"
        && fields[3].type == "bullet"
        && fields[4].type == "bullet"
        && fields[5].type == "bullet";
    }

    function isValidCanvaFields7(fields) {
      return isValidCanvaFieldShape(fields[0])
        && isValidCanvaFieldShape(fields[1])
        && isValidCanvaFieldShape(fields[2])
        && isValidCanvaFieldShape(fields[3])
        && isValidCanvaFieldShape(fields[4])
        && isValidCanvaFieldShape(fields[5])
        && isValidCanvaFieldShape(fields[6])
        && fields[0].type == "headline"
        && fields[1].type == "subtitle"
        && fields[2].type == "bullet"
        && fields[3].type == "bullet"
        && fields[4].type == "bullet"
        && fields[5].type == "bullet"
        && fields[6].type == "bullet";
    }

    function isValidCanvaFieldList(fields) {
      let size = fields.size();
      return (size == 1 && isValidCanvaFields1(fields))
        || (size == 2 && isValidCanvaFields2(fields))
        || (size == 3 && isValidCanvaFields3(fields))
        || (size == 4 && isValidCanvaFields4(fields))
        || (size == 5 && isValidCanvaFields5(fields))
        || (size == 6 && isValidCanvaFields6(fields))
        || (size == 7 && isValidCanvaFields7(fields));
    }

    function isValidCanvaTemplate(template) {
      return template.keys().hasOnly([
          "name",
          "description",
          "canvaUrl",
          "previewImageUrl",
          "enabled",
          "fields"
        ])
        && template.name is string
        && template.description is string
        && isSafeCanvaUrl(template.canvaUrl)
        && isSafePreviewImageUrl(template.previewImageUrl)
        && template.enabled is bool
        && isValidCanvaFields(template.fields);
    }

    function validCanvaConfiguration() {
      return request.resource.data.keys().hasOnly([
          "template1",
          "template2",
          "template3",
          "template4"
        ])
        && isValidCanvaTemplate(request.resource.data.template1)
        && isValidCanvaTemplate(request.resource.data.template2)
        && isValidCanvaTemplate(request.resource.data.template3)
        && isValidCanvaTemplate(request.resource.data.template4);
    }

    match /editorial_config/canva_templates {
      allow read: if request.auth != null;

      allow create: if
        isCanvaAdmin()
        && validCanvaConfiguration();

      allow update: if
        isCanvaAdmin()
        && validCanvaConfiguration();

      allow delete: if false;
    }

    match /news_brief_automation/{candidateId} {
      allow read: if isWocultStaff();
      allow update: if isWocultStaff();
      allow create, delete: if false;

      match /activity/{activityId} {
        allow read: if isWocultStaff();
        allow create: if isWocultStaff();
        allow update, delete: if false;
      }
    }

    match /news_brief_automation_runs/{runId} {
      allow read: if isWocultStaff();
      allow write: if false;
    }

    match /podcast_sessions/{sessionId} {
      allow list: if isWocultStaff();
      allow get: if canAccessPodcastSession(sessionId);
      allow create: if isWocultStaff();
      allow update: if isWocultStaff()
        || (isPodcastGuestSession(resource) && guestPodcastSessionUpdateOnly());
      allow delete: if false;

      match /responses/{questionId} {
        allow read: if canAccessPodcastSession(sessionId);
        allow create: if isWocultStaff()
          || (canAccessPodcastSession(sessionId) && isValidGuestPodcastResponseCreate(questionId));
        allow update: if isWocultStaff()
          || (canAccessPodcastSession(sessionId) && isValidGuestPodcastResponseUpdate(questionId));
        allow delete: if false;

        match /versions/{versionId} {
          allow read: if canAccessPodcastSession(sessionId);
          allow create: if isWocultStaff()
            || (canAccessPodcastSession(sessionId) && isValidGuestPodcastVersionCreate(sessionId, questionId));
          allow update: if isWocultStaff();
          allow delete: if false;
        }
      }
    }

    match /editorial_config/{documentId} {
      allow read, write: if documentId != "canva_templates";
    }

    match /{collection}/{document=**} {
      allow read, write: if
        collection != "news_brief_automation"
        && collection != "news_brief_automation_runs"
        && collection != "podcast_sessions"
        && collection != "editorial_config";
    }
  }
}
